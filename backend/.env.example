# Copy this file to .env and fill in the values. Everything is optional —
# the dashboard works fully with the keyless sources.

# Free FRED API key (St. Louis Fed) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Free NASA FIRMS key (satellite fire detection) — https://firms.modaps.eosdis.nasa.gov
FIRMS_API_KEY=

# Optional real push (APNs). Requires a paid Apple Developer account.
# Enable Push Notifications capability in Xcode, create an APNs auth key (.p8),
# then fill in:
APNS_ENABLED=0
APNS_AUTH_KEY_PATH=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.worldintel.app
